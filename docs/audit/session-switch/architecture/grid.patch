+class DocumentGridOverlay(QtQuick.QQuickPaintedItem):
+    """One scene item for all table grid segments; preserve per-table rounding."""
+    def __init__(self, parent, specs, color):
+        super().__init__(parent)
+        self.setObjectName("tableGrid")
+        self.specs = specs
+        self.color = color
+        self.setWidth(parent.width())
+        self.setHeight(max(round(r.y()) + max(1, round(r.height())) for r, _, _ in specs))
+        self.setZ(0.5)
+        self.setAcceptedMouseButtons(QtCore.Qt.NoButton)
+
+    def paint(self, painter):
+        painter.setRenderHint(QtGui.QPainter.Antialiasing, False)
+        for rect, rows, columns in self.specs:
+            ox, oy = round(rect.x()), round(rect.y())
+            width, height = max(1, round(rect.width())), max(1, round(rect.height()))
+            for y in rows:
+                local = min(max(round(y) - oy, 0), height - 1)
+                painter.fillRect(QtCore.QRectF(ox, oy + local, width, 1), self.color)
+            for x in columns:
+                local = round(x) - ox
+                if 0 <= local <= width - 1:
+                    painter.fillRect(QtCore.QRectF(ox + local, oy, 1, height), self.color)
+
+
