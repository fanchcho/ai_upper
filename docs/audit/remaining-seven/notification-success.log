# F15/F60: standard freedesktop Notify through dbus-send
$ dbus-daemon --config-file=/tmp/session-dbus.conf ... (private session bus)
$ dbus-send --session --type=method_call --print-reply \
  --dest=org.freedesktop.Notifications /org/freedesktop/Notifications \
  org.freedesktop.Notifications.Notify string:Deva uint32:0 string: \
  string:Hello string:"Body text" array:string: \
  dict:string:variant:string:urgency,string:normal int32:5000

# service method body received:
{"app": "Deva", "id": 0, "icon": "", "summary": "Hello", "body": "Body text",
 "actions": [], "hints": {"string:urgency": "normal"}, "timeout": 5000}
