{
  "path": "/v1/chat/completions",
  "body": {
    "model": "fixture",
    "messages": [
      {
        "role": "system",
        "content": "You are a helpful assistant."
      },
      {
        "role": "user",
        "content": "你好"
      }
    ],
    "max_tokens": null,
    "stream": true,
    "stream_options": {
      "include_usage": true
    },
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "read_file",
          "description": "读取工作区内一个文本文件，返回带行号的内容（便于定位与后续精确编辑）。默认从第 1 行起最多读 2000 行，超过 2000 字符的行会被截断；可用 offset（起始行，1 起）/ limit（行数）分段读取大文件，已知目标位置时建议只读相关片段。单次返回内容过大会报错，届时请缩小范围或先用 grep 定位。path 可相对项目根或绝对。注意：用 edit_file 时 old_string 应为「去掉行号前缀」的原文。也可读取图片（png / jpg / gif / webp）：图片会随结果直接附给你查看（过大时自动缩放），offset / limit 对图片无效。Word / Excel / PowerPoint 文件（.docx / .xlsx / .pptx）返回从中提取的纯文字（不含格式与图片），同样带行号、可分段读取，但不能用 edit_file 修改。",
          "parameters": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "文件路径，相对项目根或绝对路径"
              },
              "offset": {
                "type": "integer",
                "description": "起始行号（1 起，含）。默认从第 1 行。"
              },
              "limit": {
                "type": "integer",
                "description": "读取行数。默认 2000 行。"
              }
            },
            "required": [
              "path"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "list_dir",
          "description": "列出工作区内某个目录的直接子项（目录在前）。用于探索项目结构。不传 path 时默认列项目根。",
          "parameters": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "目录路径，相对项目根或绝对路径。省略则默认项目根。"
              }
            }
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "glob",
          "description": "按 glob 模式匹配工作区内的文件路径（支持 ** 任意层级、* 单层任意、? 单字符、{a,b} 分支，如 **/*.ts、src/**/*.{ts,tsx}），按最近修改时间倒序返回。默认忽略 node_modules/.git/dist 等目录。用于按名字/类型快速定位文件。",
          "parameters": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "description": "glob 模式，如 **/*.ts、src/**/*.{ts,tsx}"
              },
              "path": {
                "type": "string",
                "description": "搜索根目录，相对项目根或绝对路径。默认项目根。"
              }
            },
            "required": [
              "pattern"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "grep",
          "description": "在工作区内按正则搜索文件内容，返回匹配行（格式 路径:行号: 内容）。可选 glob 限定文件范围（如 *.ts）、ignore_case 忽略大小写。默认忽略 node_modules/.git/dist 等目录及 .gitignore 忽略的文件（path 直接指向被忽略的目录时照常搜索），跳过二进制与超大文件。用于快速定位代码。",
          "parameters": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "description": "正则表达式；搜字面量时转义元字符，如 foo\\(；非法正则会退化为纯文本搜索。"
              },
              "path": {
                "type": "string",
                "description": "搜索根目录，相对项目根或绝对路径。默认项目根。"
              },
              "glob": {
                "type": "string",
                "description": "仅搜索匹配该 glob 的文件。不含 / 时只匹配文件名（*.ts 匹配任意层级的 .ts）；含 / 时匹配相对路径。可选。"
              },
              "ignore_case": {
                "type": "boolean",
                "description": "忽略大小写。默认 false。"
              }
            },
            "required": [
              "pattern"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "web_fetch",
          "description": "获取一个网页 / HTTP(S) 资源并转为可读文本：HTML 自动去标签、解码实体、保留正文；JSON / 纯文本原样返回。用于查在线文档、读网页、取 API 响应。仅支持 http/https，有超时与大小上限；正文超过 100000 字符时完整内容存到文件，只返回开头、结尾与文件路径。",
          "parameters": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "description": "要获取的完整 URL（以 http:// 或 https:// 开头）"
              }
            },
            "required": [
              "url"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "write_file",
          "description": "把内容写入文件（覆盖式，不存在则创建；父目录不存在会自动创建）。多用于新建文件；改动既有文件请优先用 edit_file。单次写入内容较多（约 300 行以上）时请分段：先写入开头一部分，再用 append: true 分次追加其余部分。",
          "parameters": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "文件路径，相对项目根或绝对路径"
              },
              "content": {
                "type": "string",
                "description": "要写入的文本内容（覆盖时为完整内容，追加时为本段内容）"
              },
              "append": {
                "type": "boolean",
                "description": "为 true 时把 content 追加到文件末尾（不存在则创建），用于分段写入大文件。默认 false（覆盖）。"
              }
            },
            "required": [
              "path",
              "content"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "edit_file",
          "description": "对工作区内「已存在」的文件做精确替换：把 old_string 匹配到的片段替换为 new_string。默认要求 old_string 在文件中唯一出现（否则报错——请多带上下文使其唯一）；replace_all=true 时替换所有匹配。这是修改代码的首选（优于覆盖式 write_file）。",
          "parameters": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "文件路径，相对项目根或绝对路径"
              },
              "old_string": {
                "type": "string",
                "description": "要被替换的原文（需与文件内容逐字符一致，含缩进/换行；去掉 read_file 的行号前缀）"
              },
              "new_string": {
                "type": "string",
                "description": "替换后的新内容"
              },
              "replace_all": {
                "type": "boolean",
                "description": "替换所有匹配（默认 false，仅当 old_string 唯一时替换）"
              }
            },
            "required": [
              "path",
              "old_string",
              "new_string"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "run_command",
          "description": "执行一条 shell 命令并返回标准输出/错误与退出码（非交互、一次性）。用于构建、测试、git、脚本等。查找文件、搜索内容、阅读文件请用专用工具 glob / grep / read_file / list_dir，不要用 find、grep、cat、ls、head 之类的 shell 命令代替。修改文件请用 edit_file，写文件请用 write_file。命令在 bash/sh 中运行，请写 POSIX/bash 命令。工作目录：已挂载工作区时为项目根，未挂载时为用户主目录。非交互运行（已禁用分页器/凭据提示/颜色）；默认超时 600000ms（可用 timeout 调整，最长 1800000ms）；输出超过 30000 字符时完整内容存到文件，只返回开头、结尾与文件路径。命令本身不受路径守卫约束，破坏性操作（删除、覆盖、强推等）请先确认目标无误。",
          "parameters": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "description": "要执行的完整命令（可含参数）。"
              },
              "description": {
                "type": "string",
                "description": "对该命令用途的简短说明（可选，用于界面展示）。"
              },
              "timeout": {
                "type": "integer",
                "description": "超时毫秒数（可选，默认 600000，最长 1800000）。"
              }
            },
            "required": [
              "command"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "present_files",
          "description": "把本次任务产出的成品文件交付给用户：用户会看到一张交付卡。适用：生成的网页、文档、表格、演示稿、图片、音视频、数据导出等需要用户查看或使用的成品。不适用：中间产物、临时脚本，以及只是修改项目源码的编程任务。在文件全部写好后调用一次（调用时会核对文件是否存在），列出全部成品（最多 20 个）；网站等多文件产物只交付入口文件（如 index.html）。",
          "parameters": {
            "type": "object",
            "properties": {
              "paths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "成品文件路径列表：绝对路径，或相对已挂载工作区的路径。"
              }
            },
            "required": [
              "paths"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "todo_write",
          "description": "创建并维护当前任务的待办清单，界面会实时显示进度。适用：需要 3 步及以上的多步骤任务、用户一次交代了多件事。不适用：单步或琐碎的任务、纯答疑。每次调用都传**完整**清单（整表覆盖，不是增量）；同一时刻只保留一项 in_progress；做完立即标为 completed；执行中发现新步骤随时补进清单。任务被暂停、用户转向别的事而不再进行当前清单时，传 cancel: true 取消它（无需 todos）。",
          "parameters": {
            "type": "object",
            "properties": {
              "todos": {
                "type": "array",
                "description": "完整的待办清单，按执行顺序排列。",
                "items": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "string",
                      "description": "这一项要做的事：简短的祈使句。"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "in_progress",
                        "completed"
                      ],
                      "description": "pending=待办 / in_progress=进行中（同一时刻只一项）/ completed=已完成。"
                    }
                  },
                  "required": [
                    "content",
                    "status"
                  ]
                }
              },
              "title": {
                "type": "string",
                "description": "清单标题，概括这件事。新开清单时给出，更新时可省略。"
              },
              "new_list": {
                "type": "boolean",
                "description": "当前清单尚未完成、却要放下它另起一件新事时传 true。"
              },
              "cancel": {
                "type": "boolean",
                "description": "取消当前清单时传 true，此时省略 todos。"
              }
            }
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "propose_agent",
          "description": "生成角色名片供用户确认；不写盘、不创建角色。",
          "parameters": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "create_task",
          "description": "生成定时任务确认名片；用户确认后才创建任务。",
          "parameters": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "schedule": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "at": {
                    "type": "string"
                  },
                  "cron": {
                    "type": "string"
                  },
                  "tz": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "title",
              "prompt",
              "schedule"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "create_member",
          "description": "按用户要求或持续的不同工作块创建成员；一次性任务不建成员",
          "parameters": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "duty": {
                "type": "string"
              },
              "folder": {
                "type": "string"
              },
              "pick_folder": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "duty"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "member_send",
          "description": "给成员分派任务；忙碌时插入；默认直接回复用户，需要汇总时 report_to_me",
          "parameters": {
            "type": "object",
            "properties": {
              "member": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "task": {
                "type": "string"
              },
              "report_to_me": {
                "type": "boolean"
              }
            },
            "required": [
              "member",
              "task",
              "message"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "run_subagent",
          "description": "派发内置子智能体（General/Explore/Research/Plan/fork）执行独立子任务",
          "parameters": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              }
            },
            "required": [
              "prompt"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "send_to_subagent",
          "description": "向已派发的子智能体继续发消息",
          "parameters": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              }
            },
            "required": [
              "agent",
              "prompt"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "member_status",
          "description": "查看成员名单、当前任务与最近结论",
          "parameters": {
            "type": "object",
            "properties": {
              "member": {
                "type": "string"
              }
            }
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "member_stop",
          "description": "停止指定成员当前回合",
          "parameters": {
            "type": "object",
            "properties": {
              "member": {
                "type": "string"
              }
            },
            "required": [
              "member"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "ask_user",
          "description": "向用户提问并等待回答；关闭、取消、超时都不是同意。",
          "parameters": {
            "type": "object",
            "properties": {
              "questions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "properties": {
                    "question": {
                      "type": "string"
                    },
                    "choices": {
                      "type": "array",
                      "maxItems": 6,
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "question"
                  ]
                }
              }
            },
            "required": [
              "questions"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "exit_plan",
          "description": "提交计划，等待用户批准、继续完善或忽略。",
          "parameters": {
            "type": "object",
            "properties": {
              "plan": {
                "type": "string"
              }
            },
            "required": [
              "plan"
            ]
          }
        }
      }
    ]
  }
}