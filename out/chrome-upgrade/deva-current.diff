--- /dev/null
+++ b/plugins/deva-agent/lib/persona-avatar.mjs
@@ -0,0 +1,79 @@
+/**
+ * 只读 persona 头像：与桌面 `services/avatar-image.ts` / py_upper `avatar_image.py` 同一规则。
+ *
+ * 桌面把用户上传的头像图片放在 `<root>/personas/avatars/<id>.<ext>`，扩展名按 **webp → png → jpg**
+ * 的顺序找第一张；MIME 与扩展名固定对应，解码后大小必须在 1..2MiB。`persona` frontmatter 里的
+ * `avatar` 是 Humation 头像 spec（JSON 字符串），**不是图片文件**；没有自定义图片时桌面由 id 确定性生成。
+ *
+ * 本模块只用这些文件做只读展示，不写入、不创建、不改桌面字段；路径与文件都做安全校验：
+ *  · 拒绝非法 persona id（`..` / 分隔符）；
+ *  · 拒绝符号链接（目录与文件都拒），realpath 必须仍落在 `personas/avatars` 内；
+ *  · 只接受 webp/png/jpg，且文件头魔数必须与扩展名一致；
+ *  · 大小 1..2MiB，空文件/超大文件都拒绝。
+ */
+
+import { lstatSync, readFileSync, realpathSync } from 'node:fs'
+import { join, sep } from 'node:path'
+import { DevaIdentityError, resolveDevaRoot } from './deva-fs.mjs'
+import { isPersonaId } from './persona-file.mjs'
+
+/** 扩展名 → MIME，顺序与桌面一致（先 webp，再 png，再 jpg）。 */
+export const AVATAR_FORMATS = Object.freeze([['webp', 'image/webp'], ['png', 'image/png'], ['jpg', 'image/jpeg']])
+export const AVATAR_MAX_BYTES = 2 * 1024 * 1024
+
+function matchesMagic(buffer, mime) {
+  if (mime === 'image/png') return buffer.length >= 8 && buffer.subarray(0, 8).equals(Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]))
+  if (mime === 'image/jpeg') return buffer.length >= 3 && buffer[0] === 0xff && buffer[1] === 0xd8 && buffer[2] === 0xff
+  if (mime === 'image/webp') return buffer.length >= 12 && buffer.subarray(0, 4).toString('ascii') === 'RIFF' && buffer.subarray(8, 12).toString('ascii') === 'WEBP'
+  return false
+}
+
+export function personaAvatarsDir(config = {}) {
+  return join(resolveDevaRoot(config), 'personas', 'avatars')
+}
+
+/**
+ * 读 persona 自定义头像。
+ * @returns {{dataUri: string, mime: string, bytes: number, path: string} | null} 没有图片时返回 null。
+ * @throws {DevaIdentityError} 路径/文件异常（非法 id、符号链接、越界、格式不符、大小异常）。
+ */
+export function readPersonaAvatar(config = {}, id) {
+  if (!isPersonaId(id)) throw new DevaIdentityError('DEVA_AVATAR_BAD_ID', `非法身份 id：${String(id)}`)
+  const dir = personaAvatarsDir(config)
+  let dirStat
+  try {
+    dirStat = lstatSync(dir)
+  } catch (error) {
+    if (error.code === 'ENOENT') return null
+    throw new DevaIdentityError('DEVA_AVATAR_DIR_UNREADABLE', `头像目录不可读：${dir}（${error.code || '未知错误'}）`, { path: dir })
+  }
+  if (dirStat.isSymbolicLink()) throw new DevaIdentityError('DEVA_AVATAR_DIR_SYMLINK', `头像目录不能是符号链接：${dir}`, { path: dir })
+  if (!dirStat.isDirectory()) throw new DevaIdentityError('DEVA_AVATAR_DIR_NOT_DIRECTORY', `头像路径不是目录：${dir}`, { path: dir })
+  let dirReal
+  try { dirReal = realpathSync(dir) } catch (error) { throw new DevaIdentityError('DEVA_AVATAR_DIR_UNREADABLE', `头像目录无法解析：${dir}`, { path: dir }) }
+
+  for (const [ext, mime] of AVATAR_FORMATS) {
+    const candidate = join(dir, `${id}.${ext}`)
+    let stat
+    try {
+      stat = lstatSync(candidate)
+    } catch (error) {
+      if (error.code === 'ENOENT') continue
+      throw new DevaIdentityError('DEVA_AVATAR_UNREADABLE', `头像文件不可读：${candidate}（${error.code || '未知错误'}）`, { path: candidate })
+    }
+    if (stat.isSymbolicLink()) throw new DevaIdentityError('DEVA_AVATAR_SYMLINK', `头像文件不能是符号链接：${candidate}`, { path: candidate })
+    if (!stat.isFile()) throw new DevaIdentityError('DEVA_AVATAR_NOT_FILE', `头像路径不是普通文件：${candidate}`, { path: candidate })
+    if (stat.size < 1) throw new DevaIdentityError('DEVA_AVATAR_EMPTY', `头像文件为空：${candidate}`, { path: candidate })
+    if (stat.size > AVATAR_MAX_BYTES) throw new DevaIdentityError('DEVA_AVATAR_TOO_LARGE', `头像文件超过 2MiB：${candidate}`, { path: candidate })
+    let real
+    try { real = realpathSync(candidate) } catch (error) { throw new DevaIdentityError('DEVA_AVATAR_UNREADABLE', `头像文件无法解析：${candidate}`, { path: candidate }) }
+    if (real !== join(dirReal, `${id}.${ext}`) || !real.startsWith(dirReal + sep)) {
+      throw new DevaIdentityError('DEVA_AVATAR_ESCAPE', `头像文件解析后超出 personas/avatars：${candidate}`, { path: candidate })
+    }
+    let buffer
+    try { buffer = readFileSync(real) } catch (error) { throw new DevaIdentityError('DEVA_AVATAR_UNREADABLE', `头像文件不可读：${candidate}`, { path: candidate }) }
+    if (!matchesMagic(buffer, mime)) throw new DevaIdentityError('DEVA_AVATAR_BAD_MAGIC', `头像文件头与扩展名不符（需要 ${mime}）：${candidate}`, { path: candidate })
+    return { dataUri: `data:${mime};base64,${buffer.toString('base64')}`, mime, bytes: buffer.length, path: real }
+  }
+  return null
+}
diff --git a/plugins/deva-agent/lib/persona-file.mjs b/plugins/deva-agent/lib/persona-file.mjs
new file mode 100644
index 0000000..96b310d
--- /dev/null
+++ b/plugins/deva-agent/lib/persona-file.mjs
@@ -0,0 +1,96 @@
+/**
+ * 桌面端 persona 文件的格式层：与 `apps/desktop/src/main/services/frontmatter.ts` /
+ * `personas.ts#composePersonaMd` 同一口径，保证两端读写同一份 `.md` 时逐字节兼容。
+ *
+ *  · frontmatter 只认文件开头的 `---` 块与 `key: 标量`；
+ *  · 值含 `: # [ ] { } " ' 换行` 或首尾空白时用双引号并转义 `\` / `"`（与 fmScalar 对称）；
+ *  · 正文 = 结束行之后的全部内容（去掉紧随的一个空行），写盘时 trim。
+ */
+
+import { createHash } from 'node:crypto'
+
+/** 桌面 `isSafeId`：文件名即身份 id，禁止 `..` 与路径分隔符。 */
+const ID_RE = /^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$/
+
+export function isPersonaId(id) {
+  return typeof id === 'string' && ID_RE.test(id) && id !== '.' && id !== '..'
+}
+
+function stripQuotes(value) {
+  const text = value.trim()
+  if (text.length >= 2 && text[0] === '"' && text.endsWith('"')) {
+    return text.slice(1, -1).replace(/\\(["\\])/g, '$1')
+  }
+  if (text.length >= 2 && text[0] === "'" && text.endsWith("'")) return text.slice(1, -1)
+  return text
+}
+
+/** 解析 frontmatter：返回 `{ data, body }`；没有有效头部时 data 为空、body 为原文。 */
+export function parseFrontmatter(raw) {
+  const text = String(raw).replace(/^\uFEFF/, '')
+  const lines = text.split(/\r?\n/)
+  if (lines[0]?.trim() !== '---') return { data: {}, body: text }
+  let end = -1
+  for (let i = 1; i < lines.length; i++) {
+    if (lines[i].trim() === '---') { end = i; break }
+  }
+  if (end === -1) return { data: {}, body: text }
+  const data = {}
+  for (let i = 1; i < end; i++) {
+    const match = /^([A-Za-z0-9_-]+)\s*:\s*(.*)$/.exec(lines[i])
+    if (!match) continue
+    const rest = match[2].trim()
+    // 桌面还支持内联数组/缩进列表/映射；角色文件只用标量，其余形状按空串处理（与 fmString 一致）。
+    if (rest.startsWith('[') || rest === '') continue
+    data[match[1]] = stripQuotes(rest)
+  }
+  let bodyStart = end + 1
+  if (lines[bodyStart] !== undefined && lines[bodyStart].trim() === '') bodyStart++
+  return { data, body: lines.slice(bodyStart).join('\n') }
+}
+
+/** 桌面 `fmScalar`：特殊字符或首尾空白时加双引号并转义。 */
+export function fmScalar(value) {
+  const text = String(value ?? '')
+  if (text === '') return '""'
+  if (/[:#[\]{}"'\n]/.test(text) || /^\s|\s$/.test(text)) {
+    return `"${text.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`
+  }
+  return text
+}
+
+/** 组装 persona 文件：frontmatter 只写非空标量 + 正文（与桌面 composePersonaMd 一致）。 */
+export function composePersonaFile({ name, description = '', avatar = '', model = '', workspace = '', prompt = '' }) {
+  const lines = ['---', `name: ${fmScalar(name)}`]
+  if (description) lines.push(`description: ${fmScalar(description)}`)
+  if (avatar) lines.push(`avatar: ${fmScalar(avatar)}`)
+  if (model) lines.push(`model: ${fmScalar(model)}`)
+  if (workspace) lines.push(`workspace: ${fmScalar(workspace)}`)
+  lines.push('---', '', String(prompt).trim(), '')
+  return lines.join('\n')
+}
+
+/** Replace only the editable metadata and body; keep desktop-only header lines verbatim. */
+export function editPersonaFile(raw, { name, description, prompt }) {
+  const bom = raw.startsWith('\uFEFF') ? '\uFEFF' : ''
+  const newline = raw.match(/\r?\n/)?.[0] ?? '\n'
+  const lines = raw.slice(bom.length).split(/\r?\n/)
+  const end = lines[0]?.trim() === '---' ? lines.findIndex((line, i) => i > 0 && line.trim() === '---') : -1
+  const edited = [`name: ${fmScalar(name)}`]
+  if (description) edited.push(`description: ${fmScalar(description)}`)
+  const other = []
+  for (let i = 1; i < end; i++) {
+    const match = /^(?:name|description)\s*:\s*(.*)$/.exec(lines[i])
+    if (!match) other.push(lines[i])
+    else if (!match[1].trim()) {
+      while (i + 1 < end && /^\s+(?:-\s+|[A-Za-z0-9_.-]+\s*:)/.test(lines[i + 1])) i++
+    }
+  }
+  return bom + [lines[0]?.trim() === '---' && end > 0 ? lines[0] : '---', ...edited, ...other,
+    end > 0 ? lines[end] : '---', '', ...prompt.split(/\r?\n/), ''].join(newline)
+}
+
+/** 桌面 `promptHash`：统一换行、去首尾空白后取 sha256。 */
+export function promptHash(prompt) {
+  return createHash('sha256').update(String(prompt ?? '').replace(/\r\n/g, '\n').trim()).digest('hex')
+}
diff --git a/plugins/deva-agent/lib/persona-store.mjs b/plugins/deva-agent/lib/persona-store.mjs
new file mode 100644
index 0000000..bf66a25
--- /dev/null
+++ b/plugins/deva-agent/lib/persona-store.mjs
@@ -0,0 +1,246 @@
+/**
+ * 桌面端 persona 存储：**身份内容的唯一真源**。
+ *
+ * 位置（与 Deva 桌面端 / py_upper 完全一致）：
+ *  · `<root>/personas/<id>.md` —— frontmatter `name/description/avatar/model/workspace` + 正文提示词；
+ *  · `<root>/config.json → personas.enabled[id]`、`personas.order[]` —— 启用位与手动排序。
+ *
+ * 插件不再保存第二份身份正文（0.8.4 的 `deva-agent/identity.json.identities` 就是那份副本，已在 0.8.5 迁移掉），
+ * 只在 config.json 留「用哪个身份」的选择。这样桌面端改角色 = 插件下一轮读到的就是同一份文件，
+ * 不存在定时同步或覆盖先后的问题。
+ *
+ * 新增登记启用和排序；编辑仅修改名称、描述和正文；`config.json` 用读-合并-比对-原子写，
+ * 保留其它顶层键（models 等）与未知字段。
+ */
+
+import { createHash, randomBytes } from 'node:crypto'
+import { readdirSync, unlinkSync } from 'node:fs'
+import { join } from 'node:path'
+import {
+  DevaIdentityError, ensurePrivateDirectory, readStrictText, resolveDevaRoot, statOrNull, writeAtomic,
+} from './deva-fs.mjs'
+import { composePersonaFile, editPersonaFile, fmScalar, isPersonaId, parseFrontmatter } from './persona-file.mjs'
+
+const object = value => value !== null && typeof value === 'object' && !Array.isArray(value)
+
+export function personasDir(config = {}) {
+  return join(resolveDevaRoot(config), 'personas')
+}
+
+export function devaConfigPath(config = {}) {
+  return join(resolveDevaRoot(config), 'config.json')
+}
+
+/** 读 `config.json`：不存在返回空对象；坏 JSON/非对象明确报错（不静默当空配置覆盖用户文件）。 */
+export function readDevaConfig(config = {}) {
+  const path = devaConfigPath(config)
+  const file = readStrictText(path)
+  if (!file) return { raw: null, value: {}, exists: false, path, repaired: false }
+  let value
+  try {
+    value = JSON.parse(file.raw)
+  } catch {
+    throw new DevaIdentityError('DEVA_CONFIG_INVALID_JSON', `Deva config.json 不是合法 JSON：${path}；没有覆盖，请修正或先备份`, { path })
+  }
+  if (!object(value)) throw new DevaIdentityError('DEVA_CONFIG_INVALID_SHAPE', `Deva config.json 顶层应为对象：${path}`, { path })
+  return { raw: file.raw, value, exists: true, path, repaired: file.repaired }
+}
+
+function parsePersona(id, raw, enabled) {
+  const { data, body } = parseFrontmatter(raw)
+  const prompt = body.trim()
+  return {
+    id,
+    name: (data.name || '').trim() || id,
+    description: data.description || '',
+    avatar: data.avatar || '',
+    model: data.model || '',
+    workspace: data.workspace || '',
+    prompt,
+    enabled,
+  }
+}
+
+/**
+ * 列出身份内容。排序与桌面一致：`personas.order` 中出现的 id 按其位置在前，其余按名称排序。
+ * 读不了/正文为空的文件不参与身份选择，但会记进 `problems`（不静默吞掉）。
+ */
+export function listPersonas(config = {}, { includeEmpty = false } = {}) {
+  const root = resolveDevaRoot(config)
+  const dir = join(root, 'personas')
+  const cfg = readDevaConfig(config)
+  const section = object(cfg.value.personas) ? cfg.value.personas : {}
+  const enabled = object(section.enabled) ? section.enabled : {}
+  const order = Array.isArray(section.order) ? section.order.filter(item => typeof item === 'string') : []
+  const list = []
+  const problems = []
+  const stat = statOrNull(dir)
+  if (stat) {
+    if (stat.isSymbolicLink()) throw new DevaIdentityError('DEVA_PERSONAS_SYMLINK', `personas 目录不能是符号链接：${dir}`, { path: dir })
+    if (!stat.isDirectory()) throw new DevaIdentityError('DEVA_PERSONAS_NOT_DIRECTORY', `personas 路径不是目录：${dir}`, { path: dir })
+    for (const entry of readdirSync(dir)) {
+      if (!entry.toLowerCase().endsWith('.md')) continue
+      const id = entry.slice(0, -3)
+      if (!isPersonaId(id)) { problems.push({ id, reason: 'invalid-id' }); continue }
+      try {
+        const file = readStrictText(join(dir, entry))
+        const persona = parsePersona(id, file.raw, enabled[id] === true)
+        if (!persona.prompt) {
+          problems.push({ id, reason: 'empty-prompt' })
+          if (!includeEmpty) continue
+        }
+        list.push(persona)
+      } catch (error) {
+        problems.push({ id, reason: 'unreadable', message: error?.message ?? String(error) })
+      }
+    }
+  }
+  const rank = new Map(order.map((id, index) => [id, index]))
+  list.sort((a, b) => {
+    const ra = rank.has(a.id) ? rank.get(a.id) : Number.MAX_SAFE_INTEGER
+    const rb = rank.has(b.id) ? rank.get(b.id) : Number.MAX_SAFE_INTEGER
+    if (ra !== rb) return ra - rb
+    return a.name.localeCompare(b.name)
+  })
+  return {
+    list, dir, problems,
+    order,
+    config: cfg,
+    getPersona: id => list.find(item => item.id === id) ?? null,
+  }
+}
+
+/** 读一条身份内容；不存在或非法 id 返回 null。 */
+export function getPersona(config, id) {
+  if (!isPersonaId(id)) return null
+  const path = join(personasDir(config), `${id}.md`)
+  const file = readStrictText(path)
+  if (!file) return null
+  const cfg = readDevaConfig(config)
+  const section = object(cfg.value.personas) ? cfg.value.personas : {}
+  const enabled = object(section.enabled) ? section.enabled : {}
+  return parsePersona(id, file.raw, enabled[id] === true)
+}
+
+/** 新建 persona 文件；**已存在则报错**，不覆盖用户/桌面已有内容。 */
+export function createPersona(config, { id, name, description = '', avatar = '', model = '', workspace = '', prompt }) {
+  if (!isPersonaId(id)) throw new DevaIdentityError('DEVA_PERSONA_BAD_ID', `身份 id 不合法：${String(id)}`)
+  if (typeof prompt !== 'string' || !prompt.trim()) throw new DevaIdentityError('DEVA_PERSONA_EMPTY', `身份正文为空：${id}`)
+  const dir = personasDir(config)
+  ensurePrivateDirectory(dir)
+  const path = join(dir, `${id}.md`)
+  if (statOrNull(path)) throw new DevaIdentityError('DEVA_PERSONA_EXISTS', `身份文件已存在，未覆盖：${path}`, { path })
+  writeAtomic(path, composePersonaFile({ name, description, avatar, model, workspace, prompt }), { expectedRaw: null })
+  return { id, name, description, avatar, model, workspace, prompt: prompt.trim(), enabled: false, path }
+}
+
+const stamp = raw => createHash('sha256').update(raw).digest('hex')
+const nameKey = name => name.normalize('NFKC').trim().toLowerCase()
+
+function editableFields(config, input) {
+  const { id } = input
+  const name = input.name.trim()
+  const description = input.description.trim()
+  const prompt = input.prompt.trim()
+  if (!name || !prompt) throw new DevaIdentityError('DEVA_PERSONA_FIELDS', '请填写身份名称和提示词正文')
+  if (/[\p{Cc}\p{Zl}\p{Zp}]/u.test(input.name + input.description) || prompt.includes('\0')) {
+    throw new DevaIdentityError('DEVA_PERSONA_CHARACTERS', '名称和描述必须是单行且不含控制字符；提示词不可含 NUL')
+  }
+  const { list } = listPersonas(config, { includeEmpty: true })
+  const key = nameKey(name)
+  if (list.find(persona => persona.id === id && nameKey(persona.name) === key) === undefined
+    && list.some(persona => persona.id !== id && nameKey(persona.name) === key)) {
+    throw new DevaIdentityError('DEVA_PERSONA_NAME_EXISTS', '已有同名身份；请输入不同的名称（不区分大小写和全角）')
+  }
+  return { name, description, prompt }
+}
+
+/** Desktop slug + 8 random hex digits; no user-provided path is accepted. */
+export function addStudioPersona(config, input) {
+  const fields = editableFields(config, input)
+  const slug = fields.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 40) || 'persona'
+  const dir = personasDir(config)
+  let id
+  do { id = `${slug}-${randomBytes(4).toString('hex')}` } while (statOrNull(join(dir, `${id}.md`)))
+  const { path } = createPersona(config, { id, ...fields })
+  const written = composePersonaFile(fields)
+  try {
+    updatePersonasSection(config, section => ({
+      ...section,
+      order: [...(Array.isArray(section.order) ? section.order.filter(item => item !== id) : []), id],
+      enabled: { ...(object(section.enabled) ? section.enabled : {}), [id]: true },
+    }))
+  } catch (error) {
+    try {
+      if (readStrictText(path)?.raw !== written) throw new Error('persona changed')
+      unlinkSync(path)
+    } catch {
+      throw new DevaIdentityError('DEVA_PERSONA_PARTIAL', `身份文件 ${id}.md 已写入，但登记和自动撤销失败；请检查 personas 目录和 config.json 后再试`)
+    }
+    throw error
+  }
+  return { id }
+}
+
+function readPersonaForEdit(config, id) {
+  if (!isPersonaId(id)) throw new DevaIdentityError('DEVA_PERSONA_BAD_ID', '身份 ID 不合法：仅允许字母、数字、点、下划线、连字符（最多 64 字符）')
+  const dir = personasDir(config)
+  const info = statOrNull(dir)
+  if (info && !info.isDirectory()) throw new DevaIdentityError('DEVA_PERSONAS_NOT_DIRECTORY', 'personas 必须是普通目录，不能是符号链接')
+  const path = join(dir, `${id}.md`)
+  const file = readStrictText(path)
+  if (!file) throw new DevaIdentityError('DEVA_PERSONA_NOT_FOUND', '身份不存在；请刷新列表')
+  return { path, raw: file.raw, revision: stamp(file.raw) }
+}
+
+/** Update only the model scalar; preserve all other frontmatter and body bytes. */
+export function writePersonaModel(config, id, modelRef) {
+  const { path, raw } = readPersonaForEdit(config, id)
+  const newline = raw.match(/\r?\n/)?.[0] ?? '\n'
+  const lines = raw.split(/\r?\n/)
+  const end = lines[0]?.replace(/^﻿/, '').trim() === '---' ? lines.findIndex((line, i) => i > 0 && line.trim() === '---') : -1
+  if (end < 0) throw new Error('身份文件缺少有效的 frontmatter；没有覆盖')
+  const header = lines.slice(1, end).filter(line => !/^model\s*:/.test(line))
+  if (modelRef) header.push(`model: ${fmScalar(modelRef)}`)
+  writeAtomic(path, [lines[0], ...header, ...lines.slice(end)].join(newline), { expectedRaw: raw })
+}
+
+export function readStudioPersona(config, id) {
+  const { raw, revision } = readPersonaForEdit(config, id)
+  const { name, description, prompt } = parsePersona(id, raw, false)
+  return { id, name, description, prompt, revision }
+}
+
+export function updateStudioPersona(config, input) {
+  const { path, raw, revision } = readPersonaForEdit(config, input.id)
+  if (revision !== input.revision) throw new DevaIdentityError('DEVA_PERSONA_STALE', '身份已被另一处修改；请重新打开编辑，避免覆盖')
+  const fields = editableFields(config, input)
+  ensurePrivateDirectory(personasDir(config))
+  writeAtomic(path, editPersonaFile(raw, fields), { expectedRaw: raw })
+  return { id: input.id }
+}
+
+/**
+ * 读-合并 personas 段并原子写回；保留 config.json 的其它顶层键与段内未知字段。
+ * `mutate(section)` 返回新的 section（或修改传入对象）；写前比对原文，冲突则拒绝覆盖。
+ * 返回 `{ config, written }`。
+ */
+/** 通用 config.json 段更新：保留其它顶层键与段内未知字段，写前比对原文。 */
+export function updateConfigSection(config, name, mutate) {
+  if (typeof name !== 'string' || !name.trim()) throw new DevaIdentityError('DEVA_CONFIG_SECTION_INVALID', 'config 段名不能为空')
+  const cfg = readDevaConfig(config)
+  const current = object(cfg.value[name]) ? { ...cfg.value[name] } : {}
