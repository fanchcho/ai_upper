--- /dev/null
+++ b/plugins/deva-agent/lib/compression.mjs
@@ -0,0 +1,23 @@
+/** Optional extractive summary for Hermes/Ekko ordinary chats only; Studio owns history rewriting. */
+export function summarizeConversation(input, run) {
+  if (run.config?.compressionEnabled !== true || run.signal?.aborted) return null
+  if (!Number.isSafeInteger(input.summaryBudget) || input.summaryBudget < 128 || !input.transcript?.trim()) return null
+  const prefix = `${input.previousSummary ? `${input.previousSummary}\n` : ''}[Deva extractive summary; omitted middle content]\n`
+  // Use UTF-8 bytes as a conservative upper bound, leaving host validation authoritative.
+  const budget = Math.min(input.summaryBudget, 16000)
+  const room = budget - Buffer.byteLength(prefix)
+  if (room < 64) return null // Never discard the previous summary just to squeeze in new text.
+  const chars = [...input.transcript]
+  let head = '', tail = '', used = 0
+  for (const ch of chars) { const size = Buffer.byteLength(ch); if (used + size > Math.floor(room * 0.6)) break; head += ch; used += size }
+  for (const ch of chars.reverse()) { const size = Buffer.byteLength(ch); if (used + size + 5 > room) break; tail = ch + tail; used += size }
+  return `${prefix}${head}\n...\n${tail}`
+}
+export function registerCompression(ctx) {
+  if (ctx.config?.compressionEnabled !== true) return
+  if (typeof ctx.extensions.compression?.register !== 'function') {
+    ctx.log.warn('deva: compression 已开启，但宿主未提供注册接口；保持宿主内置摘要器')
+    return
+  }
+  ctx.lifecycle.add(ctx.extensions.compression.register(summarizeConversation))
+}
diff --git a/plugins/deva-agent/lib/custom-model-network.mjs b/plugins/deva-agent/lib/custom-model-network.mjs
new file mode 100644
index 0000000..e6a919e
--- /dev/null
+++ b/plugins/deva-agent/lib/custom-model-network.mjs
@@ -0,0 +1,94 @@
+import { lookup } from 'node:dns/promises'
+import { request as httpRequest } from 'node:http'
+import { request as httpsRequest } from 'node:https'
+import { BlockList, isIP } from 'node:net'
+import { Readable } from 'node:stream'
+
+const nonPublic = new BlockList()
+for (const [address, prefix] of [
+  ['0.0.0.0', 8], ['10.0.0.0', 8], ['100.64.0.0', 10], ['127.0.0.0', 8], ['169.254.0.0', 16],
+  ['172.16.0.0', 12], ['192.0.0.0', 24], ['192.0.2.0', 24], ['192.88.99.0', 24], ['192.168.0.0', 16],
+  ['198.18.0.0', 15], ['198.51.100.0', 24], ['203.0.113.0', 24], ['224.0.0.0', 3],
+]) nonPublic.addSubnet(address, prefix)
+for (const [address, prefix] of [['2001::', 23], ['2001:db8::', 32], ['2002::', 16], ['3fff::', 20]]) {
+  nonPublic.addSubnet(address, prefix, 'ipv6')
+}
+const globalV6 = new BlockList()
+globalV6.addSubnet('2000::', 3, 'ipv6')
+
+/** 用户可自行修正的输入错误：设置 RPC 把它作为字段级结果返回，不当作插件异常。 */
+export class ModelInputError extends Error {
+  constructor(field, code, message) {
+    super(message)
+    this.field = field
+    this.code = code
+  }
+}
+
+export function normalizeBaseUrl(value) {
+  let url
+  try { url = new URL(value) } catch { throw new Error('模型 API 地址必须是以 https:// 或 http:// 开头的完整 URL，例如 https://api.example.com/v1') }
+  if (!['https:', 'http:'].includes(url.protocol) || url.username || url.password || url.href.includes('?') || url.href.includes('#') ||
+      !/^https?:\/\/[^/\\\s]+/i.test(value) || /[\\\s]/.test(value) || url.pathname.replace(/\/+$/, '').endsWith('/chat/completions')) {
+    throw new Error('模型 API 地址不得包含用户信息、查询、片段或 /chat/completions；请填写 Base URL')
+  }
+  return url.href.replace(/\/+$/, '')
+}
+
+function publicAddress({ address, family }) {
+  if (family === 4) return !nonPublic.check(address)
+  return family === 6 && globalV6.check(address, 'ipv6') && !nonPublic.check(address, 'ipv6')
+}
+
+/**
+ * Approval is exact: only that normalized base, not an origin or arbitrary path.
+ * `trustedBases` holds the user's confirmed base for this user + Profile and any administrator-approved bases.
+ */
+export function customModelEndpoint(baseUrl, trustedBases = []) {
+  const base = normalizeBaseUrl(baseUrl)
+  const trusted = trustedBases.includes(base)
+  const url = new URL(`${base}/chat/completions`)
+  const hostname = url.hostname.replace(/^\[|\]$/g, '')
+  const family = isIP(hostname)
+  if (!trusted && (url.protocol !== 'https:' || (family && !publicAddress({ address: hostname, family })))) {
+    throw new ModelInputError('allowNonPublic', 'confirmation-required',
+      `${base} 是本机、内网或 HTTP 地址，尚未确认放行；请联系 Studio 管理员将此完整地址加入 modelTrustedBases，或改用公网 HTTPS 地址`)
+  }
+  return { url, trusted, hostname, family }
+}
+
+// Direct requests only. Pin DNS for this connection so it cannot change between validation and connect.
+export async function requestCustomModel({ url, trusted, hostname, family }, { headers, body, signal }) {
+  signal?.throwIfAborted()
+  let addresses
+  try { addresses = family ? [{ address: hostname, family }] : await lookup(hostname, { all: true }) }
+  catch { throw new Error('自定义模型 API DNS 解析失败；未回退') }
+  signal?.throwIfAborted()
+  if (!addresses.length || (!trusted && addresses.some(address => !publicAddress(address)))) {
+    throw new Error('自定义模型 API 的域名未解析到公网地址；如确属本机/内网服务，请联系 Studio 管理员批准该 Base URL；未回退')
+  }
+  const send = url.protocol === 'https:' ? httpsRequest : httpRequest
+  return new Promise((resolve, reject) => {
+    const request = send(url, {
+      method: 'POST', agent: false, signal,
+      headers: { ...headers, 'content-length': Buffer.byteLength(body) },
+      lookup: (_hostname, options, done) => {
+        const results = addresses.filter(item => !options.family || item.family === options.family)
+        if (!results.length) return done(new Error('No approved address for this family'))
+        if (options.all) return done(null, results)
+        return done(null, results[0].address, results[0].family)
+      },
+    }, response => {
+      const status = response.statusCode
+      if (status < 200 || status >= 300) {
+        response.destroy()
+        reject(new Error(`自定义模型 API 返回 HTTP ${status}；未回退`))
+      } else if (!/^text\/event-stream(?:\s*;|$)/i.test(response.headers['content-type'] || '')) {
+        response.destroy()
+        reject(new Error('自定义模型 API 未返回 Chat Completions SSE；未回退'))
+      } else resolve({ ok: true, body: Readable.toWeb(response) })
+    })
+    request.on('error', () => reject(new Error('无法连接自定义模型 API；未回退')))
+    request.end(body)
+  })
+}
diff --git a/plugins/deva-agent/lib/desktop-models.mjs b/plugins/deva-agent/lib/desktop-models.mjs
new file mode 100644
index 0000000..3760f39
--- /dev/null
+++ b/plugins/deva-agent/lib/desktop-models.mjs
@@ -0,0 +1,211 @@
+/**
+ * 桌面端模型配置（`~/.deva/config.json`）的只读视图与受控写入。
+ *
+ * 字段与桌面端 `renderer/src/store/models.tsx` / `services/model-resolve.ts` 一致：
+ *  · `models.providers[]`：Provider（id/name/kind/purpose/accent/adapter/apiHost/enabled/models）
+ *  · `models.activeModelId`：`"<providerId>:<modelId>"`（模型 id 本身可含冒号，按第一个冒号拆）
+ *  · `models.providers[].models[]`：ModelDef（id/name/enabled/tags/contextWindow/maxOutput…）
+ *
+ * 只改「默认模型引用」与指定 provider 的 `apiHost` / 模型清单；其它 provider、其它顶层键、
+ * 桌面 secrets.json 只检查 provider ID，不解密、不写入。写入前比对原文，通过原子 rename 落盘；
+ * 已运行的桌面进程持有内存快照，保存前应先退出桌面。
+ */
+
+import { createHash } from 'node:crypto'
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { normalizeBaseUrl } from './custom-model-network.mjs'
+import { ensurePrivateDirectory, resolveDevaRoot, resolveDevaRootSource, statOrNull, writeAtomic } from './deva-fs.mjs'
+import { readDevaConfig } from './persona-store.mjs'
+
+const object = value => value !== null && typeof value === 'object' && !Array.isArray(value)
+
+export function desktopConfigPath(config = {}) {
+  return join(resolveDevaRoot(config), 'config.json')
+}
+
+export function readDesktopConfig(config = {}) {
+  checkDesktopRoot(config)
+  return readDevaConfig(config)
+}
+
+/**
+ * 桌面配置根的归属审计。
+ *
+ * POSIX 主机上照旧严格校验：目录必须存在、是普通目录、属于当前进程用户、且组/其他不可写。
+ *
+ * Windows 等没有 `process.getuid` 的宿主上，Node 的 `mode` 是合成的（目录通常是 `0o40777`），
+ * 既不能用来判断归属，也不能用来判断他人可写。此时**不假装校验通过**，而是返回
+ * `ownership: 'unverifiable'` 让页面显式说明；真正的访问控制由 Studio 账号级授权
+ * （`sharedDevaUserId`）与管理员给的绝对路径承担。绝不因为校验不了就把目录当成别人的、直接拒读。
+ */
+export function desktopRootAudit(config = {}) {
+  const { path, source } = resolveDevaRootSource(config)
+  const stat = statOrNull(path)
+  if (typeof process.getuid === 'function') {
+    if (stat && (!stat.isDirectory() || stat.uid !== process.getuid() || (stat.mode & 0o022))) {
+      throw new Error('共享 Deva 配置目录必须是当前 OS 用户拥有的不可由其他用户写入的普通目录')
+    }
+    return { root: path, source, ownership: 'verified' }
+  }
+  if (stat && !stat.isDirectory()) throw new Error(`Deva 配置路径不是目录：${path}`)
+  return { root: path, source, ownership: 'unverifiable' }
+}
+
+function checkDesktopRoot(config) {
+  return desktopRootAudit(config).root
+}
+
+/** 路径位置与是否存在：只用于页面/自检核对「读的是不是桌面那一份」，不返回任何内容。 */
+export function desktopConfigLocation(config = {}) {
+  const { root, ownership, source } = desktopRootAudit(config)
+  const path = join(root, 'config.json')
+  return { path, exists: Boolean(statOrNull(path)), ownership, source }
+}
+
+function readModels(value) {
+  if (value.models != null && !object(value.models)) throw new Error('桌面 config.json 的 models 不是对象')
+  const models = value.models ?? {}
+  if (models.providers != null && !Array.isArray(models.providers)) throw new Error('桌面 config.json 的 models.providers 不是数组')
+  const providers = Array.isArray(models.providers) ? models.providers.filter(object) : []
+  return { models, providers }
+}
+
+function defaultRoute(models, providers, reference = models.activeModelId) {
+  const separator = typeof reference === 'string' ? reference.indexOf(':') : -1
+  if (separator <= 0) return null
+  const providerId = reference.slice(0, separator).trim()
+  const modelId = reference.slice(separator + 1).trim()
+  const provider = providers.find(item => item.id === providerId)
+  if (!providerId || !modelId || !Array.isArray(provider?.models) || !provider.models.some(item => item?.id === modelId)) return null
+  return { providerId, modelId, baseUrl: String(provider.apiHost || ''), modelName: modelId }
+}
+
+/** 桌面默认模型的内部视图；不作为 Studio RPC 响应。 */
+export function listDesktopModels(config = {}) {
+  const { value, path, exists } = readDesktopConfig(config)
+  const { models, providers } = readModels(value)
+  return {
+    path,
+    exists,
+    activeModelId: typeof models.activeModelId === 'string' ? models.activeModelId : null,
+    active: defaultRoute(models, providers),
+    providers: providers.map(item => ({
+      id: String(item.id || ''),
+      name: String(item.name || item.id || ''),
+      apiHost: String(item.apiHost || ''),
+      adapter: String(item.adapter || ''),
+      enabled: item.enabled !== false,
+      models: (Array.isArray(item.models) ? item.models : []).map(model => ({ id: String(model.id || ''), name: String(model.name || model.id || ''), enabled: model.enabled !== false })),
+    })),
+  }
+}
+
+/** 桌面配置里某个 provider 的模型路由（运行期用；不返回密钥）。 */
+export function readDesktopRoute(config = {}) {
+  const { models, providers } = readModels(readDesktopConfig(config).value)
+  const route = defaultRoute(models, providers)
+  return route?.baseUrl.trim() ? { ...route, baseUrl: normalizeBaseUrl(route.baseUrl) } : null
+}
+
+/** Resolve the same references as Desktop; strip invalid/sensitive URL components from public settings. */
+export function desktopModelState(config = {}) {
+  const snapshot = readDesktopConfig(config)
+  const { models, providers } = readModels(snapshot.value)
+  const resolve = ref => {
+    const route = defaultRoute(models, providers, ref)
+    if (!route) return null
+    const provider = providers.find(item => item.id === route.providerId)
+    let baseUrl = ''
+    try { baseUrl = normalizeBaseUrl(route.baseUrl) } catch { /* unsupported/implicit Desktop endpoint */ }
+    const adapter = provider.adapter === 'openai' || provider.adapter === 'responses' ? provider.adapter : 'anthropic'
+    return { ...route, ref: ref ?? models.activeModelId, adapter, baseUrl }
+  }
+  const choices = providers.flatMap(p => (Array.isArray(p.models) ? p.models : [])
+    .filter(m => p.enabled === true && (p.purpose ?? 'llm') === 'llm' && m?.enabled === true && typeof m.id === 'string')
+    .map(m => resolve(`${p.id}:${m.id}`)).filter(Boolean))
+  return { snapshot, models, providers, active: resolve(models.activeModelId ?? null), resolve, choices }
+}
+
+export function writeDesktopDefaults(config, snapshot, models) {
+  if (JSON.stringify(models) === JSON.stringify(snapshot.value.models)) return
+  if (!snapshot.exists) ensurePrivateDirectory(checkDesktopRoot(config))
+  writeAtomic(snapshot.path, `${JSON.stringify({ ...snapshot.value, models }, null, 2)}
+`, { expectedRaw: snapshot.raw })
+}
+
+/** Edit the selected existing provider, or reuse/add a custom provider for a new Base URL.
+ * Selection, migration and credential-save retries are idempotent and preserve other settings. */
+export function writeDesktopModel(config, state, { route, ref = '', select = true, effort } = {}) {
+  const { providers, models, snapshot } = state
+  if (!route) {
+    if (!select || (!snapshot.exists && !effort) || (models.activeModelId == null && effort === undefined)) return null
+    writeDesktopDefaults(config, snapshot, { ...models, activeModelId: null, ...(effort === undefined ? {} : { activeEffort: effort || 'default' }) })
+    return null
+  }
+  const existing = ref ? state.resolve(ref) : null
+  if (ref && !existing) throw new Error('桌面模型引用已不存在，请刷新后重选')
+  const matching = !ref && state.choices.find(p => p.adapter === 'openai' && p.baseUrl === route.baseUrl && p.modelName === route.modelName)
+  const candidate = existing || matching
+  const providerId = candidate?.providerId ?? `deva-studio-${createHash('sha256').update(route.baseUrl).digest('hex').slice(0, 20)}`
+  const provider = providers.find(p => p.id === providerId)
+  if (!candidate && provider && (provider.apiHost !== route.baseUrl || provider.adapter !== 'openai')) {
+    throw new Error('新模型提供方 ID 与现有桌面配置冲突；未写入')
+  }
+  if (candidate && candidate.baseUrl !== route.baseUrl && desktopSecretProviderIds(config).has(providerId)) {
+    throw new Error('该提供方在桌面端已有密钥；换 Base URL 请先在桌面端修改（或先清除该提供方密钥）')
+  }
+  const previous = (provider?.models ?? []).find(m => m.id === route.modelName)
+  const model = { name: route.modelName, ...previous, id: route.modelName, enabled: true }
+  const nextProvider = {
+    id: providerId, name: 'Deva Studio', kind: 'custom', purpose: 'llm', accent: '#8a8a94',
+    adapter: 'openai', ...provider, enabled: candidate && previous ? provider.enabled : true,
+    apiHost: route.baseUrl, models: previous
+      ? provider.models.map(m => m === previous ? (candidate ? previous : model) : m)
+      : [...(provider?.models ?? []), model],
+  }
+  const next = {
+    ...models,
+    providers: provider ? providers.map(p => p === provider ? nextProvider : p) : [...providers, nextProvider],
+    ...(select ? { activeModelId: `${providerId}:${route.modelName}` } : {}),
+    ...(effort === undefined ? {} : { activeEffort: effort || 'default' }),
+  }
+  writeDesktopDefaults(config, snapshot, next)
+  return desktopModelState(config).resolve(`${providerId}:${route.modelName}`)
+}
+function desktopSecretProviderIds(config) {
+  const path = join(resolveDevaRoot(config), 'secrets.json')
+  try {
+    const parsed = JSON.parse(readFileSync(path, 'utf8'))
+    if (!object(parsed)) throw new Error()
+    return new Set(Object.keys(parsed))
+  } catch (error) {
+    if (error.code === 'ENOENT') return new Set()
+    throw new Error('无法核对桌面密钥记录；没有更改 Base URL')
+  }
+}
+
+export function selectDesktopModel(config = {}, { providerId, modelId, baseUrl } = {}) {
+  const snapshot = readDesktopConfig(config)
+  const { models, providers } = readModels(snapshot.value)
+  const previousProvider = providers.find(item => item.id === providerId)
+  if (!previousProvider) throw new Error(`桌面端没有这个模型提供方：${String(providerId)}`)
+  const provider = { ...previousProvider, models: Array.isArray(previousProvider.models) ? [...previousProvider.models] : [] }
+  const id = String(modelId || '').trim()
+  if (!id) throw new Error('请选择模型名')
+  if (baseUrl) {
+    const nextBase = normalizeBaseUrl(baseUrl)
+    if ((!provider.apiHost || normalizeBaseUrl(String(provider.apiHost)) !== nextBase) && desktopSecretProviderIds(config).has(provider.id)) {
+      // 桌面按 provider id 绑定 safeStorage 密文；有密钥时换地址前必须由用户在桌面端处理。
+      throw new Error('该提供方在桌面端已有密钥；换 Base URL 请先在桌面端修改（或先清除该提供方密钥）')
+    }
+    provider.apiHost = nextBase
+  }
+  if (!provider.models.some(item => item?.id === id)) provider.models.push({ id, name: id, enabled: true })
+  const next = {
+    ...snapshot.value,
+    models: { ...models, providers: providers.map(item => item === previousProvider ? provider : item), activeModelId: `${providerId}:${id}` },
+  }
+  writeDesktopDefaults(config, snapshot, next.models)
+  return listDesktopModels(config)
+}
diff --git a/plugins/deva-agent/lib/deva-fs.mjs b/plugins/deva-agent/lib/deva-fs.mjs
new file mode 100644
index 0000000..ad1f42e
--- /dev/null
+++ b/plugins/deva-agent/lib/deva-fs.mjs
@@ -0,0 +1,165 @@
+/**
+ * Deva 根目录、错误类型与严格文件 IO。
+ *
+ * 身份内容与桌面端共用 `<root>/personas/*.md` 和 `<root>/config.json`（见 lib/persona-store.mjs）；
+ * 默认和会话选择在 config.json 的 personas 段。共用这里的根解析与写入原语，
+ * 避免出现「两套 ~/.deva」或两种权限口径。
+ */
+
+import { randomUUID } from 'node:crypto'
+import {
+  chmodSync, closeSync, existsSync, fsyncSync, lstatSync, mkdirSync, openSync,
+  readFileSync, renameSync, unlinkSync, writeFileSync,
+} from 'node:fs'
+import { homedir } from 'node:os'
+import { dirname, isAbsolute, join, resolve } from 'node:path'
+
+/** 身份/配置相关的明确错误：带稳定 code、路径与可操作提示，绝不回显文件内容。 */
+export class DevaIdentityError extends Error {
+  constructor(code, message, detail = {}) {
+    super(message)
+    this.name = 'DevaIdentityError'
+    this.code = code
+    Object.assign(this, detail)
+  }
+}
+
+/** POSIX 归属能力在调用时判断：Windows 上没有 getuid，模块级缓存会让平台判定与运行期不一致。 */
+const hasPosixOwnership = () => typeof process.getuid === 'function'
+
+/**
+ * Deva 配置根：`sharedDevaHome` → `DEVA_HOME` → `~/.deva`；必须是绝对路径且不是主目录/根目录。
+ * 同时返回来源，供 Windows 这类拿不到 POSIX 归属的平台判断「这个路径是谁给的」。
+ */
+export function resolveDevaRootSource(config = {}) {
+  const configured = typeof config?.sharedDevaHome === 'string' ? config.sharedDevaHome.trim() : ''
+  const fromEnv = process.env.DEVA_HOME?.trim() || ''
+  const root = configured || fromEnv || join(homedir(), '.deva')
+  if (!isAbsolute(root)) throw new DevaIdentityError('DEVA_HOME_NOT_ABSOLUTE', `Deva 配置目录必须是绝对路径：${root}`)
+  const path = resolve(root)
+  if (path === dirname(path) || path === resolve(homedir())) {
+    throw new DevaIdentityError('DEVA_HOME_TOO_BROAD', `Deva 配置目录不能是根目录或用户主目录：${path}`)
+  }
+  return { path, source: configured ? 'config' : fromEnv ? 'env' : 'home' }
+}
+
+export function resolveDevaRoot(config = {}) {
+  return resolveDevaRootSource(config).path
+}
+
+export function statOrNull(path) {
+  try {
+    return lstatSync(path)
+  } catch (error) {
+    if (error.code === 'ENOENT') return null
+    throw new DevaIdentityError('DEVA_STAT_FAILED', `无法读取 ${path}（${error.code || '未知错误'}）`, { path })
+  }
+}
+
+/** 确保目录存在且只有 owner 可访问；返回 true 表示新建或收紧过权限。 */
+export function ensurePrivateDirectory(path) {
+  let stat = statOrNull(path)
+  const created = !stat
+  if (!stat) {
+    try {
+      mkdirSync(path, { recursive: true, mode: 0o700 })
+    } catch (error) {
+      throw new DevaIdentityError('DEVA_MKDIR_FAILED', `无法创建 Deva 目录 ${path}（${error.code || '未知错误'}）`, { path })
+    }
+    stat = statOrNull(path)
+  }
+  if (stat?.isSymbolicLink()) throw new DevaIdentityError('DEVA_DIR_SYMLINK', `Deva 目录不能是符号链接：${path}`, { path })
+  if (!stat?.isDirectory()) throw new DevaIdentityError('DEVA_NOT_DIRECTORY', `Deva 路径不是目录：${path}`, { path })
+  if (!hasPosixOwnership()) return created
+  if (stat.uid !== process.getuid()) {
+    throw new DevaIdentityError('DEVA_DIR_OWNER', `Deva 目录不属于当前进程用户（uid ${process.getuid()}）：${path}`, { path })
+  }
+  if ((stat.mode & 0o7777) !== 0o700) {
+    try {
+      chmodSync(path, 0o700)
+      return true
+    } catch (error) {
+      throw new DevaIdentityError('DEVA_DIR_CHMOD_FAILED', `无法把 Deva 目录收紧到 0700：${path}（${error.code || '未知错误'}）`, { path })
+    }
+  }
+  return created
+}
+
+/**
+ * 严格读取一个文件：拒绝符号链接、非常规文件、硬链接、非本用户；顺手把过宽权限收紧到 0600。
+ * 文件不存在返回 null。
+ */
+export function readStrictText(path) {
+  const stat = statOrNull(path)
+  if (!stat) return null
+  if (stat.isSymbolicLink()) throw new DevaIdentityError('DEVA_FILE_SYMLINK', `不能是符号链接：${path}`, { path })
+  if (!stat.isFile()) throw new DevaIdentityError('DEVA_NOT_FILE', `不是普通文件：${path}`, { path })
+  if (stat.nlink !== 1) throw new DevaIdentityError('DEVA_FILE_HARDLINK', `不能是硬链接：${path}`, { path })
+  if (hasPosixOwnership() && stat.uid !== process.getuid()) {
+    throw new DevaIdentityError('DEVA_FILE_OWNER', `文件不属于当前进程用户（uid ${process.getuid()}）：${path}`, { path })
+  }
+  let repaired = false
+  if (hasPosixOwnership() && (stat.mode & 0o077)) {
+    try {
+      chmodSync(path, 0o600)
+      repaired = true
+    } catch (error) {
+      throw new DevaIdentityError('DEVA_FILE_CHMOD_FAILED', `无法把文件收紧到 0600：${path}（${error.code || '未知错误'}）`, { path })
+    }
+  }
+  try {
+    return { raw: readFileSync(path, 'utf8'), repaired, stat }
+  } catch (error) {
+    throw new DevaIdentityError('DEVA_FILE_UNREADABLE', `文件不可读：${path}（${error.code || '未知错误'}）`, { path })
+  }
+}
+
+/**
+ * 原子写：同目录临时文件（0600、独占创建、fsync）+ 可选「写前比对原内容」+ rename。
+ * `expectedRaw`：字符串表示必须是这个内容，null 表示文件必须不存在，省略表示不比对。
+ */
+export function writeAtomic(path, content, { expectedRaw } = {}) {
+  const dir = dirname(path)
+  const tmp = join(dir, `.${randomUUID()}.tmp`)
+  let pending = false
+  try {
+    let fd
+    try {
+      fd = openSync(tmp, 'wx', 0o600)
+    } catch (error) {
+      throw new DevaIdentityError('DEVA_WRITE_FAILED', `无法在 ${dir} 创建临时文件（${error.code || '未知错误'}）`, { path })
+    }
+    pending = true
+    try {
+      writeFileSync(fd, content, 'utf8')
+      fsyncSync(fd)
+    } finally {
+      closeSync(fd)
+    }
+    if (expectedRaw !== undefined) {
+      const current = existsSync(path) ? readFileSync(path, 'utf8') : null
+      if (current !== expectedRaw) {
+        throw new DevaIdentityError('DEVA_CONCURRENT_WRITE', `文件在保存期间被其它进程修改，没有覆盖：${path}；请重新打开再保存`, { path })
+      }
+    }
+    if (hasPosixOwnership()) {
+      try { chmodSync(tmp, 0o600) } catch { /* 创建时已是 0600 */ }
+    }
+    renameSync(tmp, path)
+    pending = false
+  } finally {
+    if (pending) {
+      try { unlinkSync(tmp) } catch { /* 保留原始写入错误 */ }
+    }
+  }
+}
+
+/** 把一段原文备份到 `.deva` 之外（默认 `~/.deva-backups`）；返回绝对路径。 */
+export function backupText(config, raw, name) {
+  const dir = join(process.env.DEVA_BACKUP_ROOT?.trim() || join(homedir(), '.deva-backups'), `text-${Date.now()}`)
+  ensurePrivateDirectory(dir)
+  const stamp = new Date().toISOString().replace(/[:.]/g, '-')
+  const path = join(dir, name.includes('.') ? `${name}-${stamp}` : `${name}-${stamp}`)
+  writeAtomic(path, raw, { expectedRaw: null })
+  return path
+}
diff --git a/plugins/deva-agent/lib/deva-home.mjs b/plugins/deva-agent/lib/deva-home.mjs
new file mode 100644
index 0000000..4e7b3d4
--- /dev/null
+++ b/plugins/deva-agent/lib/deva-home.mjs
@@ -0,0 +1,177 @@
+/**
+ * 身份选择（桌面同构版）：**persona 正文落 `personas/*.md`，默认选择落桌面 `config.json`**。
+ *
+ * 桌面端没有「当前选中 persona」字段（personas 是多条叠加），所以插件把选择写在
+ * `config.json → personas.selected`（personas 段内的扩展键）。桌面 `getConfig()` 读得到整段；
+ * 桌面 `writeEnabledMap()` 用 `{...base, enabled}` 合并，会保留 `selected` 与 `sessionSelected`。
+ *
+ * 旧布局 `<root>/deva-agent/` 一次性迁移（见 lib/deva-layout.mjs）：备份到 `.deva` 之外后删除，
+ * 不再作为运行期存储。persona 正文只读写 `personas/*.md`。
+ */
+
+import { join } from 'node:path'
+import { DevaIdentityError, resolveDevaRoot, statOrNull } from './deva-fs.mjs'
+import { createPersona, getPersona, listPersonas, personasDir, updatePersonasSection } from './persona-store.mjs'
+import { isPersonaId, promptHash } from './persona-file.mjs'
+import { readPersonaAvatar } from './persona-avatar.mjs'
+import { IDENTITIES, DEFAULT_IDENTITY, loadIdentity } from './identities.mjs'
+import { migrateLegacyLayout, readConfigSelection, writeConfigSelection } from './deva-layout.mjs'
+
+export { DevaIdentityError, resolveDevaRoot }
+
+export const IDENTITY_SCHEMA_VERSION = 3
+export const DEFAULT_PERSONA_ID = 'general'
+/** 0.8.4 及更早 id `deva` 对应桌面 persona `general`（身份文件迁移/旧输入用，不是旧会话兼容）。 */
+export const LEGACY_ID_ALIASES = Object.freeze({ deva: 'general' })
+
+export function canonicalIdentityId(id) {
+  return Object.hasOwn(LEGACY_ID_ALIASES, id) ? LEGACY_ID_ALIASES[id] : id
+}
+
+/** 选择态现在写在桌面 config.json 里；保留该函数供 UI 显示文件位置。 */
+export function identityFilePath(config = {}) {
+  return join(resolveDevaRoot(config), 'config.json')
+}
+
+/** 选择态结构校验（config.personas 段）。 */
+export function identityProblems(value) {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return ['personas 段应为对象']
+  const problems = []
+  if (value.selected !== undefined && (typeof value.selected !== 'string' || !isPersonaId(canonicalIdentityId(value.selected)))) problems.push('selected 不是合法身份 id')
+  if (value.sessionSelected !== undefined && (value.sessionSelected === null || typeof value.sessionSelected !== 'object' || Array.isArray(value.sessionSelected))) problems.push('sessionSelected 应为对象')
+  return problems
+}
+
+const object = value => value !== null && typeof value === 'object' && !Array.isArray(value)
+
+function pickSelection(list, candidates) {
+  for (const candidate of candidates) {
+    if (typeof candidate !== 'string') continue
+    const wanted = canonicalIdentityId(candidate)
+    if (list.some(item => item.id === wanted)) return wanted
+  }
+  return list.find(item => item.id === DEFAULT_PERSONA_ID)?.id ?? list[0]?.id ?? ''
+}
+
+async function seedBundledPersonas(config) {
+  const mapping = [{ personaId: DEFAULT_PERSONA_ID, sourceId: DEFAULT_IDENTITY }, { personaId: 'xiaomajiang', sourceId: 'xiaomajiang' }]
+  const created = []
+  for (const { personaId, sourceId } of mapping) {
+    if (getPersona(config, personaId)) continue
+    if (!IDENTITIES.some(item => item.id === sourceId)) continue
+    const record = await loadIdentity(sourceId)
+    createPersona(config, { id: personaId, name: record.name, description: record.description, prompt: record.persona })
+    created.push(personaId)
+  }
+  if (created.length) {
+    const enabled = {}
+    const seeded = {}
+    for (const id of created) { enabled[id] = true; seeded[id] = true }
+    updatePersonasSection(config, section => ({
+      ...section,
+      enabled: { ...enabled, ...(object(section.enabled) ? section.enabled : {}) },
+      seeded: { ...(object(section.seeded) ? section.seeded : {}), ...seeded },
+    }))
+  }
+  return created
+}
+
+/**
+ * 确保选择态存在：迁移旧 deva-agent → 读取 personas → 若 `personas.selected` 缺失/失效则写入候选。
+ * @returns {Promise<{value:{selected:string}, path:string, personas, created:boolean, migrated:boolean, repaired:boolean}>}
+ */
+export async function ensureIdentityState(config = {}, { legacySelection = null } = {}) {
+  const migration = migrateLegacyLayout(config)
+  let personas = listPersonas(config)
+  let seeded = false
+  if (personas.list.length === 0) { await seedBundledPersonas(config); personas = listPersonas(config); seeded = true }
+  const current = readConfigSelection(config)
+  const selected = pickSelection(personas.list, [current.selected, legacySelection, DEFAULT_PERSONA_ID])
+  if (selected && selected !== current.selected) writeConfigSelection(config, selected)
+  return {
+    value: { selected },
+    path: identityFilePath(config),
+    personas,
+    created: seeded,
+    migrated: Boolean(migration.migrated),
+    migration,
+    repaired: false,
+  }
+}
+
+export function inspectIdentityFile(config = {}) {
+  const root = resolveDevaRoot(config)
+  const describe = stat => stat && { mode: `0${(stat.mode & 0o777).toString(8)}`, uid: stat.uid, size: stat.size, mtime: stat.mtime.toISOString(), directory: stat.isDirectory(), file: stat.isFile(), symlink: stat.isSymbolicLink() }
+  const dir = personasDir(config)
+  let personas = null
+  try { personas = listPersonas(config).list.map(item => item.id) } catch { personas = null }
+  return {
+    root,
+    path: identityFilePath(config),
+    personasDir: dir,
+    rootDir: describe(statOrNull(root)),
+    configStat: describe(statOrNull(identityFilePath(config))),
+    file: describe(statOrNull(identityFilePath(config))),
+    personasDirStat: describe(statOrNull(dir)),
+    personas,
+  }
+}
+
+/** 身份目录 + 当前选择（设置页/命令共用）。 */
+export async function listIdentityCatalog(config = {}, options = {}) {
+  const state = await ensureIdentityState(config, options)
+  const list = options.includeEmpty ? listPersonas(config, { includeEmpty: true }).list : state.personas.list
+  const identities = list.map(item => {
+    const view = {
+      id: item.id, name: item.name, description: item.description,
+      promptSha256: promptHash(item.prompt), avatar: item.avatar || '', model: item.model || '',
+      workspace: item.workspace || '', enabled: item.enabled === true,
+      ...(options.includeEmpty ? { hasPrompt: Boolean(item.prompt) } : {}),
+    }
+    try {
+      // 头像读取在 persona-avatar；这里延迟 import 会让测试桩复杂，改为同步顶层 import。
