.cf-pane {
  min-height: 0;
  overflow-y: auto;
  padding: var(--space-4) var(--space-5);
}
.cf-pane__title {
  margin: 0;
  font-size: 15px;
  font-weight: 700;
}
.cf-pane__desc {
  margin: 6px 0 var(--space-4);
  font-size: 12px;
  color: var(--fg-subtle);
}

/* 设置项：语言/主题/发送键 */
.cf-set {
  display: flex;
  flex-direction: column;
  margin-top: var(--space-4);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.cf-set__row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 12px 14px;
}
.cf-set__row + .cf-set__row {
  border-top: 1px solid var(--border);
}
.cf-set__label {
  display: flex;
  flex-direction: column;
  gap: 2px;
  font-size: 13px;
  font-weight: 600;
  color: var(--fg);
}
.cf-set__hint {
  font-size: 11px;
  font-weight: 400;
  color: var(--fg-subtle);
}

/* 分段选择器 */
.cf-seg {
  margin-left: auto;
  display: inline-flex;
  padding: 2px;
  background: var(--bg-inset);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  gap: 2px;
}
.cf-seg__opt {
  padding: 5px 12px;
  border: none;
  background: transparent;
  color: var(--fg-muted);
  font-size: 12px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  white-space: nowrap;
}
.cf-seg__opt:hover {
  color: var(--fg);
}
.cf-seg__opt.is-on {
  background: var(--bg-elevated);
  color: var(--fg);
  font-weight: 600;
  box-shadow: var(--shadow);
}

