  margin-bottom: 0;
}
/* ===== 助手 Markdown 正文（GFM）===== */
/* 字号与段距乘以「文字大小」倍率 --cs：只在对话区（.cf-msgs / .cf-draft，见 redesign.css）有值，别处的 Markdown 回落 1 倍 */
.md {
  font-size: calc(14px * var(--cs, 1));
  line-height: 1.65;
  color: var(--fg);
  word-break: break-word;
  overflow-wrap: anywhere;
}
.md > :first-child {
  margin-top: 0;
}
.md > :last-child {
  margin-bottom: 0;
}
.md p {
  margin: 0 0 calc(var(--space-3) * var(--cs, 1));
}
.md ul,
.md ol {
  margin: 0 0 calc(var(--space-3) * var(--cs, 1));
  padding-left: 1.5em;
}
.md li {
  margin: calc(2px * var(--cs, 1)) 0;
}
.md li > ul,
.md li > ol {
  margin: 2px 0;
}
.md li::marker {
  color: var(--fg-subtle);
}
.md h1,
.md h2,
.md h3,
.md h4,
.md h5,
.md h6 {
  margin: calc(var(--space-4) * var(--cs, 1)) 0 calc(var(--space-2) * var(--cs, 1));
  font-weight: 650;
  line-height: 1.3;
}
.md h1 {
  font-size: 1.5em;
}
.md h2 {
  font-size: 1.3em;
  padding-bottom: 0.2em;
  border-bottom: 1px solid var(--border);
}
.md h3 {
  font-size: 1.15em;
}
.md h4 {
  font-size: 1em;
}
.md h5,
.md h6 {
  font-size: 0.9em;
  color: var(--fg-muted);
}
.md a {
  color: var(--accent);
  text-decoration: none;
}
.md a:hover {
  text-decoration: underline;
}
.md strong {
  font-weight: 650;
}
.md blockquote {
  margin: 0 0 calc(var(--space-3) * var(--cs, 1));
  padding: 2px 0 2px var(--space-3);
  border-left: 3px solid var(--border-strong);
  color: var(--fg-muted);
}
.md blockquote > :last-child {
  margin-bottom: 0;
}
.md hr {
  border: none;
  border-top: 1px solid var(--border);
  margin: calc(var(--space-4) * var(--cs, 1)) 0;
}
.md img {
  max-width: 100%;
  border-radius: var(--radius-sm);
}
/* GFM 表格：横向可滚，不撑破通栏 */
.md table {
  display: block;
  width: max-content;
  max-width: 100%;
  overflow-x: auto;
  border-collapse: collapse;
  margin: 0 0 calc(var(--space-3) * var(--cs, 1));
  font-size: calc(13px * var(--cs, 1));
