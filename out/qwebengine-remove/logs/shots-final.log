### 夹具重建（此前 /tmp/fx-qml-home 已被清掉，直接跑 qml_pages_all.sh 会拍出空态）
$ .venv/bin/python scripts/parity/make_pages_fixture.py /tmp/fx-pages
$ .venv/bin/python scripts/parity/make_pages_config.py /tmp/fx-page-home --model
$ .venv/bin/python scripts/parity/make_pages_config.py /tmp/fx-dark-home --theme dark --model && cp /tmp/fx-dark-home/config.json /tmp/fx-page-home/config-dark.json
$ .venv/bin/python scripts/parity/make_qml_home.py /tmp/fx-qml-home /tmp/fx-pages/data/chats /tmp/fx-page-home

