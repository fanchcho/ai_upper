+def test_separate_lists_keep_container_bottom_spacing(qapp):
+    # deva .md ol/ul margin-bottom:12px; li margin:2px must not erase it.
+    document = render("1. ordered\n\n- unordered\n\nafter")
+    ordered = find_block(document, "\t1.\tordered")
+    unordered = find_block(document, "\t•\tunordered")
+    assert ordered.blockFormat().bottomMargin() == 12.0
+    assert unordered.blockFormat().bottomMargin() == 12.0
+    assert document.lastBlock().blockFormat().bottomMargin() == 0.0
+
