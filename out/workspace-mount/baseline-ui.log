33:         scale: icon.size / 24
34:         transformOrigin: Item.TopLeft
35:         preferredRendererType: Shape.CurveRenderer
36:         // 线宽是 viewBox 单位，先按缩放倒回，使屏幕上呈现 strokeWidth * size/24 的视觉线宽
37:         // 与原版 `<svg stroke-width=2>` 在同样尺寸下一致。
